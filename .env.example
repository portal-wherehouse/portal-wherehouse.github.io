# Copy to .env.local. The web app config is public; never use service-account keys here.
VITE_FIREBASE_CONFIG={"apiKey":"YOUR_WEB_API_KEY","authDomain":"YOUR_PROJECT.firebaseapp.com","projectId":"YOUR_PROJECT","storageBucket":"YOUR_PROJECT.firebasestorage.app","messagingSenderId":"YOUR_SENDER_ID","appId":"YOUR_WEB_APP_ID"}
# Development only. Never used by the production build.
VITE_FIREBASE_EMULATORS=false
