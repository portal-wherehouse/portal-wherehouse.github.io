# Cloudflare Pages response headers (GitHub Pages serves this file as-is and ignores it).
# The service worker and version.json must always come fresh, so a deploy reaches open apps promptly
# (see public/sw.js and src/device/pwa.ts). Build files in /assets have content hashes in their names.

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/version.json
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
