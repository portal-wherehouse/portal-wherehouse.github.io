rules_version = '2';

// Live clients read only their warehouses. All record writes go through authenticated functions.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function memberPath(ws) {
      return /databases/$(database)/documents/workspaces/$(ws)/members/$(request.auth.uid);
    }

    function licensed(ws) {
      return exists(/databases/$(database)/documents/licenses/$(ws))
        && get(/databases/$(database)/documents/licenses/$(ws)).data.active == true
        && get(/databases/$(database)/documents/licenses/$(ws)).data.expires_at > request.time;
    }

    match /licenses/{ws} {
      allow get: if signedIn() && exists(memberPath(ws)) && get(memberPath(ws)).data.active == true;
      allow list, write: if false;
    }

    // An active member of a licensed warehouse.
    function isMember(ws) {
      return signedIn() && licensed(ws)
        && exists(memberPath(ws))
        && get(memberPath(ws)).data.active == true;
    }

    function hasRole(ws, roles) {
      return isMember(ws) && get(memberPath(ws)).data.role in roles;
    }

    // Supervisor or Owner: matches Engine.auditLog and the Supervisor-only admin screens.
    function isSupervisor(ws) {
      return hasRole(ws, ['OWNER', 'SUPERVISOR']);
    }

    // A person's own profile, including the list of workspaces they belong to (kept by the function).
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow write: if false;
    }

    match /workspaces/{ws} {
      // The company document (name, created_at).
      allow get: if isMember(ws);
      allow list: if false;
      allow write: if false;

      // Coworkers' names, emails and roles. The same data the People screen shows every role today.
      match /members/{uid} {
        allow get: if isMember(ws);
        allow list: if isMember(ws) && request.query.limit != null && request.query.limit <= 100;
        allow write: if false;
      }

      // Pending invitations: admin screens only.
      match /invites/{email} {
        allow get: if isSupervisor(ws);
        allow list: if isSupervisor(ws) && request.query.limit != null && request.query.limit <= 100;
        allow write: if false;
      }

      match /warehouses/{id} {
        allow get: if isMember(ws);
        allow list: if isMember(ws) && request.query.limit != null && request.query.limit <= 100;
        allow write: if false;
      }

      match /locations/{id} {
        allow get: if isMember(ws);
        allow list: if isMember(ws) && request.query.limit != null && request.query.limit <= 100;
        allow write: if false;
      }

      match /jobs/{id} {
        allow get: if isMember(ws);
        allow list: if isMember(ws) && request.query.limit != null && request.query.limit <= 100;
        allow write: if false;
      }

      match /products/{id} {
        allow get: if isMember(ws);
        allow list: if isMember(ws) && request.query.limit != null && request.query.limit <= 100;
        allow write: if false;
      }
      match /shipments/{id} {
        allow get: if isMember(ws);
        allow list: if isMember(ws) && request.query.limit != null && request.query.limit <= 100;
        allow write: if false;
      }
      match /pallets/{id} {
        allow get: if isMember(ws);
        allow list: if isMember(ws) && request.query.limit != null && request.query.limit <= 100;
        allow write: if false;
      }

      // Append-only history. IDs are {palletId}_{revision}; the function creates, never updates.
      match /events/{id} {
        allow get: if isMember(ws);
        allow list: if isMember(ws) && request.query.limit != null && request.query.limit <= 100;
        allow write: if false;
      }

      // Label tokens, so a scanned QR resolves with one get() and the Labels screen can reprint.
      match /labels/{token} {
        allow get: if isMember(ws);
        allow list: if isMember(ws) && request.query.limit != null && request.query.limit <= 100;
        allow write: if false;
      }

      // Photo metadata. The image files are in Cloud Storage, guarded by storage.rules.
      match /attachments/{id} {
        allow get: if isMember(ws);
        allow list: if isMember(ws) && request.query.limit != null && request.query.limit <= 100;
        allow write: if false;
      }

      // Split parent and child links.
      match /lineage/{childId} {
        allow get: if isMember(ws);
        allow list: if isMember(ws) && request.query.limit != null && request.query.limit <= 100;
        allow write: if false;
      }

      // Admin audit log and import batches: Supervisor or Owner, as in the local engine.
      match /audit/{id} {
        allow get: if isSupervisor(ws);
        allow list: if isSupervisor(ws) && request.query.limit != null && request.query.limit <= 100;
        allow write: if false;
      }

      match /imports/{id} {
        allow get: if isSupervisor(ws);
        allow list: if isSupervisor(ws) && request.query.limit != null && request.query.limit <= 100;
        allow write: if false;
      }

      // Command receipts (request ID, payload hash, stored result). Only the function reads them:
      // a retry resends the same command and the function answers from the receipt.
      match /receipts/{commandId} {
        allow read, write: if false;
      }

      // Counters and anything else server-only.
      match /private/{doc} {
        allow read, write: if false;
      }
    }

    // Everything not listed above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
