rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function member(ws) {
      return request.auth != null && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/licenses/$(ws))
        && firestore.get(/databases/(default)/documents/licenses/$(ws)).data.active == true
        && firestore.get(/databases/(default)/documents/licenses/$(ws)).data.expires_at + duration.value(14, 'd') > request.time
        && firestore.exists(/databases/(default)/documents/workspaces/$(ws)/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/workspaces/$(ws)/members/$(request.auth.uid)).data.active == true;
    }
    match /workspaces/{ws}/photos/{uid}/{filename} {
      allow get: if member(ws);
      allow create, update, delete, list: if false;
    }
    match /workspaces/{ws}/photos/{uid}/{uploadId}/{filename} {
      function upload() { return firestore.get(/databases/(default)/documents/workspaces/$(ws)/uploads/$(uploadId)).data; }
      allow get: if member(ws);
      allow create: if member(ws)
        && firestore.get(/databases/(default)/documents/licenses/$(ws)).data.expires_at > request.time
        && firestore.get(/databases/(default)/documents/workspaces/$(ws)/members/$(request.auth.uid)).data.role in ['OWNER', 'SUPERVISOR', 'OPERATOR']
        && request.auth.uid == uid
        && upload().uid == uid && upload().state == 'reserved' && upload().expires_at > request.time
        && request.resource.metadata.uploadedBy == uid && request.resource.contentType == 'image/jpeg'
        && ((filename == 'full.jpeg' && request.resource.size == upload().bytes && request.resource.size <= 5*1024*1024)
          || (filename == 'thumb.jpeg' && request.resource.size == upload().thumbBytes && request.resource.size <= 128*1024));
      allow update, delete, list: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
