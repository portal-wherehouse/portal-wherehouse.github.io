rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function member(ws) {
      return request.auth != null && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/licenses/$(ws))
        && firestore.get(/databases/(default)/documents/licenses/$(ws)).data.active == true
        && firestore.get(/databases/(default)/documents/licenses/$(ws)).data.expires_at > request.time
        && firestore.exists(/databases/(default)/documents/workspaces/$(ws)/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/workspaces/$(ws)/members/$(request.auth.uid)).data.active == true;
    }
    match /workspaces/{ws}/photos/{uid}/{filename} {
      allow get: if member(ws);
      allow create: if member(ws) && request.auth.uid == uid
        && firestore.get(/databases/(default)/documents/workspaces/$(ws)/members/$(uid)).data.role in ['OWNER','SUPERVISOR','OPERATOR']
        && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.metadata.uploadedBy == uid
        && filename.matches('[a-zA-Z0-9_-]+[.](jpeg|png|webp)');
      allow update, delete, list: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
